# Copy to compute.env (gitignored) and add your key. The vendored poseidon_compute layer finds this
# file by walking up from the current directory, so run every command from the repo root.
#
# OpenRouter covers both target providers in configs/grid.json (OpenAI and Google models).
OPENROUTER_API_KEY=

# Leave this unset. It forces one model for every seat and would collapse the cross-model design.
# LLM_MODEL=

# Anthropic API, used for any model id that starts with "claude/" (configs/*_claude.json).
ANTHROPIC_API_KEY=
# Only for personal keys that are not scoped to a workspace (the API returns a 400 asking for it).
# Find the id at platform.claude.com/settings/workspaces.
ANTHROPIC_WORKSPACE_ID=
